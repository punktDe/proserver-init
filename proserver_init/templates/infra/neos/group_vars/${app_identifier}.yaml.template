---
app:
  config:
    elasticsearch:
      index: "$project_organization-{{ environment_name_abbrev }}-${app_identifier}"
      password: "{{ elasticsearch.users.builtin.elastic.password }}"
    mysql:
      database: "{{ mariadb.databases.${app_identifier}.name }}"
      username: "{{ mariadb.users.${app_identifier}.username }}"
      password: "{{ mariadb.users.${app_identifier}.password }}"
