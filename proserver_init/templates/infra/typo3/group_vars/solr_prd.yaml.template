---
dehydrated:
  domains:
    solr.prd.${project_organization}.${domain_suffix}: []

solr:
  domain: solr.prd.${project_organization}.${domain_suffix}

oauth2_proxy:
  config:
    solr:
      client_id: ${project_organization}-solr-prd
      client_secret: "{{ secrets.solr.prd.oauth2_proxy.client_secret }}"
      cookie_secret: "{{ secrets.solr.prd.oauth2_proxy.cookie_secret }}"
      htpasswd_file:
        solr: "{{ secrets.solr.prd.oauth2_proxy.htpasswd_file.solr }}"
