secrets:
  ${app_identifier}:
    prd:
      # Any strong random string: openssl rand -hex 32
      encryption_key:
      mariadb:
        password:
      oauth2_proxy:
        # Issued by your identity provider when you register the client.
        client_secret:
        # Raw binary of exactly 16, 24 or 32 bytes, base64url encoded:
        #   openssl rand -base64 32 | tr -- '+/' '-_'
        # or
        #   python3 -c 'import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
        cookie_secret:
        htpasswd_file:
          # One htpasswd line: htpasswd -nbB <user> <password>
          ${project_organization}:
    stg:
      encryption_key:
      mariadb:
        password:
      oauth2_proxy:
        client_secret:
        cookie_secret:
        htpasswd_file:
          ${project_organization}:
  solr:
    prd:
      oauth2_proxy:
        client_secret:
        cookie_secret:
        htpasswd_file:
          solr:
    stg:
      oauth2_proxy:
        client_secret:
        cookie_secret:
        htpasswd_file:
          solr:
