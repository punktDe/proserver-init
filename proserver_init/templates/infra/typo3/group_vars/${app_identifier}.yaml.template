---
app:
  config:
    mysql:
      host: 127.0.0.1
      database: '{{ mariadb.databases.${app_identifier}.name }}'
      username: '{{ mariadb.users.${app_identifier}.username }}'
      password: '{{ mariadb.users.${app_identifier}.password }}'

php:
  modules:
    disable:
      cli:
        - xmlreader
      all: []
      for_users:
        - proserver
        - "{{ ansible_user }}"

oauth2_proxy:
  config:
    main:
      http_address: "[::1]:4190"
      # Set the identity provider your organization uses, for example
      # keycloak-oidc, google or github, together with its issuer URL.
      provider:
      oidc_issuer_url:
      email_domains: []
      insecure_oidc_allow_unverified_email: true
      scope: "openid profile email"
      proxy_prefix: "/proserver/iap"
