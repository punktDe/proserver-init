---
app:
  context: Production/Staging
  domain: ${app_identifier}.stg.${project_organization}.${domain_suffix}
  oauth2_proxy: main
  config:
    encryption_key: '{{ secrets.${app_identifier}.stg.encryption_key }}'
    solr:
      host: "{{ groups.solr_stg | map('extract', hostvars) | map(attribute='solr.domain') | first }}"
      user: solr
      port: 443
      scheme: https
      password: "{{ groups.solr_stg | map('extract', hostvars) | map(attribute='oauth2_proxy.config.solr.htpasswd_file.solr') | first }}"
      core_de: core_de

oauth2_proxy:
  config:
    main:
      client_id: ${project_organization}-${app_identifier}-stg
      client_secret: "{{ secrets.${app_identifier}.stg.oauth2_proxy.client_secret }}"
      cookie_secret: "{{ secrets.${app_identifier}.stg.oauth2_proxy.cookie_secret }}"
      htpasswd_file:
        ${project_organization}: "{{ secrets.${app_identifier}.stg.oauth2_proxy.htpasswd_file.${project_organization} }}"

dehydrated:
  domains:
    ${app_identifier}.stg.${project_organization}.${domain_suffix}: []
    mail.stg.${project_organization}.${domain_suffix}: []

mariadb:
  users:
    ${app_identifier}:
      password: '{{ secrets.${app_identifier}.stg.mariadb.password }}'
